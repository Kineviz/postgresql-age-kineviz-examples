# ./gxr up creates .env with random local passwords if it is missing.
POSTGRES_PASSWORD=replace-with-a-random-local-password
KINEVIZ_PASSWORD=replace-with-a-different-random-password
AGE_PORT=5455
# Override to isolate a second checkout or CI run; do not reuse another project's name.
COMPOSE_PROJECT_NAME=postgresql-age-kineviz-examples
